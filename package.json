{
  "name": "trogon-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:full": "node scripts/dev.mjs",
    "check:server": "node server/node_modules/typescript/bin/tsc --noEmit -p server/tsconfig.json",
    "check:deploy": "node scripts/validate-deploy.mjs",
    "test:server": "node server/node_modules/tsx/dist/cli.mjs --test server/tests/*.test.ts",
    "test:integration": "node server/node_modules/tsx/dist/cli.mjs --test server/tests/integration/*.test.ts",
    "db:migrate": "node server/node_modules/tsx/dist/cli.mjs server/src/cli.ts migrate",
    "db:migrate:local": "node server/node_modules/tsx/dist/cli.mjs scripts/migrate-local.mjs",
    "db:seed": "node server/node_modules/tsx/dist/cli.mjs server/src/cli.ts seed-demo",
    "db:backup": "node server/node_modules/tsx/dist/cli.mjs server/src/backup.ts",
    "db:verify-backup": "node server/node_modules/tsx/dist/cli.mjs server/src/verify-backup.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "^1.31.0",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@types/leaflet": "^1.9.21",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
